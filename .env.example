# ── Gateway (server.js) ─────────────────────────────────────────────
PORT=5002
# Listen address. 127.0.0.1 = this machine only (default). 0.0.0.0 serves other consoles on
# the network — there is no login, so anyone who can reach the port can command the twin.
HOST=127.0.0.1

# Browser origins allowed to call the gateway (comma-separated, exact match).
# Requests from any other Origin are refused, including WebSocket upgrades.
GCS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gateway -> AI service shared key. If unset, created once in data/service.json.
# GCS_INTERNAL_KEY=<64 hex chars>
# GCS_DATA_DIR=./data

# ── AI service (ai_service.py) ──────────────────────────────────────
# Loopback only by default; only the gateway calls it (with the internal key).
AI_HOST=127.0.0.1
AI_PORT=8001
# AI_SERVICE_URL=http://127.0.0.1:8001   (gateway side)
# AI_ALLOWED_ORIGINS=                    (browser origins; empty = none, the default)
